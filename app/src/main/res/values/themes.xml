<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.LawRefBook" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!--        <item name="colorControlNormal">@color/white</item>-->
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorOnSurfaceVariant">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!--        <item name="android:windowLightStatusBar">false</item> &lt;!&ndash; 深色状态栏图标（配合浅色状态栏） &ndash;&gt;-->
        <!-- Customize your theme here. -->
        <!-- 开启 Overlay 模式 ActionMode 不要推挤布局，而是覆盖在当前 ActionBar/Toolbar 之上 -->
        <item name="windowActionModeOverlay">true</item>
        <!-- 控制 Toolbar 菜单图标和文字颜色 -->
        <item name="actionMenuTextColor">?attr/colorOnPrimary</item>
        <!-- 控制溢出菜单（overflow menu）背景 -->
        <item name="actionOverflowMenuStyle">@style/Widget.LawRefBook.PopupMenu.Overflow</item>
    </style>

    <style name="Theme.LawRefBook.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.LawRefBook.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.LawRefBook.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="BaseBottomSheetDialog" parent="@style/Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">true</item>
        <item name="bottomSheetStyle">@style/BottomSheet</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="BaseBottomSheetDialog" />

    <style name="BottomSheet" parent="Widget.Design.BottomSheet.Modal">
        <!--背景，顶部两个圆角-->
        <item name="android:background">@drawable/up_rounded</item>
    </style>

    <style name="ThemeOverlay.PrimaryPalette.Purple" parent="">
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryDark">#5c007a</item>
    </style>

</resources>