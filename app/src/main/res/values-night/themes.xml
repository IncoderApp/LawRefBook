<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.LawRefBook" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_700</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!--        <item name="colorControlNormal">@color/white</item>-->
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorOnSurfaceVariant">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- 状态栏和导航栏在 edge-to-edge 下由布局背景决定，无需设置 statusBarColor -->
        <!--        <item name="android:windowLightStatusBar">false</item> &lt;!&ndash; 深色状态栏图标（配合浅色状态栏） &ndash;&gt;-->
        <!-- Customize your theme here. -->
        <!-- 开启 Overlay 模式 ActionMode 不要推挤布局，而是覆盖在当前 ActionBar/Toolbar 之上 -->
        <item name="windowActionModeOverlay">true</item>
        <!-- 控制 Toolbar 菜单图标和文字颜色 -->
        <item name="actionMenuTextColor">?attr/colorOnPrimary</item>
        <!-- 可选：控制溢出菜单（overflow menu）背景 -->
        <item name="actionOverflowMenuStyle">@style/Widget.LawRefBook.PopupMenu.Overflow</item>
    </style>
</resources>